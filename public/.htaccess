<IfModule mod_headers.c>
  # Vite content hash: 8 characters base64url, e.g. index-CJpgqc0f.css or stores-CB-UygPI.js
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
   Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|data_de\.json|data_fr\.json)$">
   Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # The Content-Security-Policy is set in index.html; frame-ancestors only works as a header.
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
